  "components": {
    "schemas": {
      "AgentSolutionResponse": {
        "properties": {
          "customer_issue_summary": {
            "type": "string",
            "title": "Customer Issue Summary"
          },
          "detected_intent": {
            "type": "string",
            "title": "Detected Intent"
          },
          "primary_source_modality": {
            "type": "string",
            "title": "Primary Source Modality"
          },
          "policy_applied": {
            "type": "string",
            "title": "Policy Applied"
          },
          "resolution_status": {
            "type": "string",
            "title": "Resolution Status"
          },
          "actionable_agent_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Actionable Agent Steps"
          },
          "suggested_customer_reply": {
            "type": "string",
            "title": "Suggested Customer Reply"
          },
          "policy_citations": {
            "items": {
              "$ref": "#/components/schemas/PolicyCitation"
            },
            "type": "array",
            "title": "Policy Citations"
          },
          "sla_or_credit_details": {
            "type": "string",
            "title": "Sla Or Credit Details"
          },
          "execution_time_seconds": {
            "type": "number",
            "title": "Execution Time Seconds"
          },
          "retrieved_chunks_count": {
            "type": "integer",
            "title": "Retrieved Chunks Count"
          },
          "total_tokens": {
            "type": "integer",
            "title": "Total Tokens",
            "description": "Total prompt and completion tokens processed",
            "default": 0
          },
          "estimated_cost_usd": {
            "type": "number",
            "title": "Estimated Cost Usd",
            "description": "Estimated total execution cost in USD",
            "default": 0.0
          },
          "latency_breakdown": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Breakdown",
            "description": "Execution time breakdown per service in seconds"
          }
        },
        "type": "object",
        "required": [
          "customer_issue_summary",
          "detected_intent",
          "primary_source_modality",
          "policy_applied",
          "resolution_status",
          "actionable_agent_steps",
          "suggested_customer_reply",
          "policy_citations",
          "sla_or_credit_details",
          "execution_time_seconds",
          "retrieved_chunks_count"
        ],
        "title": "AgentSolutionResponse",
        "description": "Structured response synthesized for the Customer Service Representative."
      },
      "CustomerQueryRequest": {
        "properties": {
          "customer_query": {
            "type": "string",
            "minLength": 3,
            "title": "Customer Query",
            "description": "Customer's problem or inquiry message"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Optional CSR session identifier"
          },
          "policy_filter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy Filter",
            "description": "Optional policy filter (sim_replacement, wifi_troubleshooting, billing_refund, telecom_egypt_web)"
          },
          "intent_filter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent Filter",
            "description": "Optional intent filter (SIM_MANAGEMENT, WIFI_TECHNICAL_SUPPORT, BILLING_AND_PAYMENTS, PLANS_AND_OFFERS)"
          }
        },
        "type": "object",
        "required": [
          "customer_query"
        ],
        "title": "CustomerQueryRequest",
        "description": "Request payload for CSR problem resolution."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ManualScrapeRequest": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Web URL to manually scrape and ingest as a data source",
            "default": "https://www.te.eg/"
          }
        },
        "type": "object",
        "title": "ManualScrapeRequest",
        "description": "Request payload for manual URL scraping."
      },
      "PolicyCitation": {
        "properties": {
          "document": {
            "type": "string",
            "title": "Document"
          },
          "source_modality": {
            "type": "string",
            "title": "Source Modality"
          },
          "intent_category": {
            "type": "string",
            "title": "Intent Category"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "clause_summary": {
            "type": "string",
            "title": "Clause Summary"
          }
        },
        "type": "object",
        "required": [
          "document",
          "source_modality",
          "intent_category",
          "section",
          "clause_summary"
        ],
        "title": "PolicyCitation",
        "description": "Citation metadata identifying source, section, and intent category."
      },
      "ScrapeUrlRequest": {
        "properties": {
          "url": {
            "type": "string",
            "minLength": 8,
            "title": "Url",
            "description": "Target website URL to scrape in-memory and index"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "ScrapeUrlRequest",
        "description": "Request payload for scraping an online URL."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
