{
  "paths": {
    "/api/agent-assist/solve": {
      "post": {
        "tags": [
          "Agent Assist"
        ],
        "summary": "Solve Problem",
        "description": "Batch RAG endpoint — returns a complete structured JSON solution after the\nfull pipeline (embed → search → rerank → Gemini JSON) completes.\n\nRaises HTTP 500 on any pipeline failure (no silent fallback).",
        "operationId": "solve_problem_api_agent_assist_solve_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerQueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentSolutionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent-assist/solve/stream": {
      "post": {
        "tags": [
          "Agent Assist"
        ],
        "summary": "Solve Problem Stream",
        "description": "SSE streaming endpoint — yields three event types over text/event-stream:\n\n  event: context_ready  — structured Gemini JSON metadata (action steps, intent, status)\n  event: token          — one text chunk per Gemini streaming token\n  event: done           — final telemetry (latency breakdown, tokens, cost)\n\nHeaders set to prevent any proxy or browser from buffering the stream.\nRaises HTTP 500 on any pipeline failure (no silent fallback).",
        "operationId": "solve_problem_stream_api_agent_assist_solve_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerQueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
