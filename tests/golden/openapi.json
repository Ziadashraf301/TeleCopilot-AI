    "/api/scraper/run": {
      "post": {
        "tags": [
          "Manual Scraper"
        ],
        "summary": "Run Manual Scraper",
        "description": "Manually triggers in-memory scraping of any URL (such as https://www.te.eg/),\nand indexes all sections into Qdrant directly without writing to disk.",
        "operationId": "run_manual_scraper_api_scraper_run_post",
        "requestBody": {
          "content": {
