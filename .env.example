# App
APP_NAME=TeleCopilot AI
APP_ENV=development
LOG_LEVEL=INFO

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=telecom_customer_policies
QDRANT_TIMEOUT_S=10

# Postgres + Redis (deploy/compose); 127.0.0.1 avoids a slow IPv6 attempt on Windows. Inside compose: 'postgres' / 'redis'
DATABASE_URL=postgresql+psycopg://telecopilot:telecopilot@127.0.0.1:5432/telecopilot
DB_TIMEOUT_S=5
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TIMEOUT_S=2

# HTTP: allowed browser origins (JSON list)
CORS_ORIGINS=["http://localhost:8000"]

# Paths (relative to the working directory)
DATA_RAW_DIR=data/raw
STATIC_DIR=static
LOG_DIR=logs

# Model providers (ADR-2). Only these values exist until M3.
LLM_PROVIDER=gemini
EMBED_PROVIDER=cohere
RERANK_PROVIDER=cohere

# AI provider keys
COHERE_API_KEY=
GEMINI_API_KEY=

# Models (defaults shown)
DENSE_EMBEDDING_MODEL=embed-multilingual-v3.0
RERANK_MODEL=rerank-v3.5
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
LLM_MODEL=gemini-3.1-flash-lite-preview

# RAG tuning
RETRIEVAL_TOP_K=5
RERANK_TOP_N=3
SIMILARITY_THRESHOLD=0.35

# Web scraper
SCRAPER_VERIFY_SSL=true
SCRAPER_TIMEOUT_S=30

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
