# App
APP_NAME=TeleCopilot AI
APP_ENV=development
LOG_LEVEL=INFO

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=telecom_customer_policies

# AI Providers
COHERE_API_KEY=
GEMINI_API_KEY=

# Models (defaults shown)
DENSE_EMBEDDING_MODEL=embed-multilingual-v3.0
RERANK_MODEL=rerank-v3.5
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
LLM_MODEL=gemini-3.1-flash-lite-preview

# RAG tuning
RETRIEVAL_TOP_K=5
RERANK_TOP_N=3
SIMILARITY_THRESHOLD=0.35

# Web scraper
SCRAPER_VERIFY_SSL=true

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
