# Configuration Management
APP_NAME=Telecom Customer Service Agent Assist
APP_ENV=development
LOG_LEVEL=INFO

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=telecom_customer_policies

# AI Providers
COHERE_API_KEY=
GEMINI_API_KEY=

# Embedding & Search Models
COHERE_EMBED_MODEL=embed-english-v3.0
COHERE_RERANK_MODEL=rerank-v3.5
GEMINI_MODEL=gemini-1.5-flash

# Langfuse Observability
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=